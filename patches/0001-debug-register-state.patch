diff --git a/server/mach.c b/server/mach.c
index ec73dc6e390..f51f52e77e7 100644
--- a/server/mach.c
+++ b/server/mach.c
@@ -190,8 +190,12 @@ void get_thread_context( struct thread *thread, struct context_data *context, un
 
     if (is_rosetta())
     {
-        /* getting debug registers of a translated process is not supported cross-process, return all zeroes */
-        memset( &context->debug, 0, sizeof(context->debug) );
+        /* Mach cannot retrieve translated hardware debug registers. Return the
+         * Windows-visible state retained on the server thread instead. */
+        if (thread->system_regs & SERVER_CTX_DEBUG_REGISTERS)
+            context->debug = thread->debug_regs;
+        else
+            memset( &context->debug, 0, sizeof(context->debug) );
         context->flags |= SERVER_CTX_DEBUG_REGISTERS;
         return;
     }
@@ -276,10 +280,10 @@ void set_thread_context( struct thread *thread, const struct context_data *conte
 
     if (is_rosetta())
     {
-        /* Setting debug registers of a translated process is not supported cross-process
-         * (and even in-process, setting debug registers never has the desired effect).
-         */
-        set_error( STATUS_UNSUCCESSFUL );
+        /* Preserve context round trips when Mach cannot install translated
+         * hardware debug registers. This does not emulate breakpoint delivery. */
+        thread->debug_regs = context->debug;
+        thread->system_regs |= SERVER_CTX_DEBUG_REGISTERS;
         return;
     }
 
