+++ b/dlls/ntdll/tests/exception.c
@@ -9235,6 +9235,30 @@ static DWORD WINAPI register_check_thread(void *arg)
     return 0;
 }
 
+static DWORD WINAPI debug_register_resume_thread(void *arg)
+{
+    const CONTEXT *expected = arg;
+    CONTEXT ctx;
+    NTSTATUS status;
+
+    memset(&ctx, 0, sizeof(ctx));
+    ctx.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+    status = pNtGetContextThread(GetCurrentThread(), &ctx);
+    ok(!status, "NtGetContextThread failed with %lx\n", status);
+    ok(ctx.Dr0 == expected->Dr0, "expected %Ix, got %Ix\n", (DWORD_PTR)expected->Dr0, (DWORD_PTR)ctx.Dr0);
+    ok(ctx.Dr1 == expected->Dr1, "expected %Ix, got %Ix\n", (DWORD_PTR)expected->Dr1, (DWORD_PTR)ctx.Dr1);
+    ok(ctx.Dr2 == expected->Dr2, "expected %Ix, got %Ix\n", (DWORD_PTR)expected->Dr2, (DWORD_PTR)ctx.Dr2);
+    ok(ctx.Dr3 == expected->Dr3, "expected %Ix, got %Ix\n", (DWORD_PTR)expected->Dr3, (DWORD_PTR)ctx.Dr3);
+    ok((ctx.Dr6 & 0xf00f) == expected->Dr6, "unexpected Dr6 %Ix\n", (DWORD_PTR)ctx.Dr6);
+    ok((ctx.Dr7 & ~0xdc00) == expected->Dr7, "unexpected Dr7 %Ix\n", (DWORD_PTR)ctx.Dr7);
+
+    memset(&ctx, 0, sizeof(ctx));
+    ctx.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+    status = pNtSetContextThread(GetCurrentThread(), &ctx);
+    ok(!status, "NtSetContextThread failed with %lx\n", status);
+    return 0;
+}
+
 static void test_debug_registers(void)
 {
     static const struct
@@ -9317,6 +9341,35 @@ static void test_debug_registers(void)
     ResumeThread(thread);
     WaitForSingleObject(thread, 10000);
     CloseHandle(thread);
+
+    if (!is_arm64ec)
+    {
+        static const CONTEXT expected =
+        {
+            .ContextFlags = CONTEXT_DEBUG_REGISTERS,
+            .Dr0 = 0x12340000,
+            .Dr1 = 0x12340001,
+            .Dr2 = 0x12340002,
+            .Dr3 = 0x12340003,
+            .Dr7 = 0x155,
+        };
+        DWORD ret;
+
+        /* State set while suspended must remain visible after the target resumes. */
+        ctx = expected;
+        thread = CreateThread(NULL, 0, debug_register_resume_thread, (void *)&expected, CREATE_SUSPENDED, NULL);
+        ok(!!thread, "CreateThread failed with %lu\n", GetLastError());
+        if (thread)
+        {
+            status = pNtSetContextThread(thread, &ctx);
+            ok(!status, "NtSetContextThread failed with %lx\n", status);
+            ret = ResumeThread(thread);
+            ok(ret != ~0u, "ResumeThread failed with %lu\n", GetLastError());
+            ret = WaitForSingleObject(thread, 10000);
+            ok(ret == WAIT_OBJECT_0, "thread did not complete, wait returned %#lx\n", ret);
+            CloseHandle(thread);
+        }
+    }
 }
 
