+                amd64_data->dispatching_breakpoint = FALSE;
+#endif
             amd64_data->dr0 = context->Dr0;
             amd64_data->dr1 = context->Dr1;
             amd64_data->dr2 = context->Dr2;
@@ -1115,6 +1150,16 @@ NTSTATUS WINAPI NtSetContextThread( HANDLE handle, const CONTEXT *context )
         if (xs->CompactionMask) frame->xstate.Mask |= mask & ~xs->CompactionMask;
     }
 
+#ifdef __APPLE__
+    if (is_rosetta2 && emulate_rosetta_exec_breakpoints && !is_wow64())
+    {
+        if (flags & CONTEXT_CONTROL) amd64_data->application_step = !!(context->EFlags & 0x100);
+        amd64_data->emulated_step = rosetta_exec_breakpoints( amd64_data );
+        if (amd64_data->emulated_step) frame->eflags |= 0x100;
+        else if (!amd64_data->application_step) frame->eflags &= ~0x100;
+        frame->restore_flags |= CONTEXT_CONTROL;
+    }
+#endif
     frame->restore_flags |= flags & ~CONTEXT_INTEGER;
     return STATUS_SUCCESS;
 }
@@ -1167,6 +1212,10 @@ NTSTATUS WINAPI NtGetContextThread( HANDLE handle, CONTEXT *context )
         context->Rsp    = frame->rsp;
         context->Rip    = frame->rip;
