+                 amd64_data->dr7 != context->Dr7))
+                amd64_data->dispatching_breakpoint = FALSE;
+#endif
             amd64_data->dr0 = context->Dr0;
             amd64_data->dr1 = context->Dr1;
             amd64_data->dr2 = context->Dr2;
@@ -1308,7 +1364,11 @@ NTSTATUS set_thread_wow64_context( HANDLE handle, const void *ctx, ULONG size )
             amd64_data->dr6 = context->Dr6;
             amd64_data->dr7 = context->Dr7;
         }
-        if (!(flags & ~CONTEXT_I386_DEBUG_REGISTERS)) return ret;
+        if (!(flags & ~CONTEXT_I386_DEBUG_REGISTERS)
+#ifdef __APPLE__
+            && !(is_rosetta2 && emulate_rosetta_exec_breakpoints)
