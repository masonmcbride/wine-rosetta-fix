@@ -2495,10 +2580,77 @@ static void trap_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
     struct xcontext context;
     EXCEPTION_RECORD rec = { .ExceptionAddress = (void *)RIP_sig(sigcontext) };
 
+#ifdef __APPLE__
+    /* The normal single-step shortcut cannot reconstruct a WOW64 transition
+     * halfway through its stack switch. Keep internal steps transparent. */
+    if (!(emulate_rosetta_exec_breakpoints && amd64_thread_data( data )->emulated_step
+          && TRAP_sig(sigcontext) == TRAP_x86_TRCTRAP))
+#endif
     if (handle_syscall_trap( data, sigcontext, siginfo )) return;
 
+#ifdef __APPLE__
+    {
+        struct amd64_thread_data *debug = amd64_thread_data( data );
+        if (debug && debug->emulated_step && TRAP_sig(sigcontext) == TRAP_x86_TRCTRAP)
+        {
+            BYTE opcode;
+            DWORD retaddr;
+            /* Rosetta's TF path pushes eight bytes for an unprefixed x86
+             * relative CALL, although x86 RET pops four. Verify the exact
+             * instruction, stack delta, and return address before repair. */
+            if (CS_sig(sigcontext) == cs32_sel && debug->step_cs == cs32_sel &&
+                debug->step_rsp == RSP_sig(sigcontext) + 8 &&
+                virtual_uninterrupted_read_memory( (void *)debug->step_rip, &opcode, 1 ) == 1 &&
+                opcode == 0xe8 &&
+                virtual_uninterrupted_read_memory( (void *)RSP_sig(sigcontext), &retaddr, 4 ) == 4 &&
+                retaddr == debug->step_rip + 5 &&
+                !virtual_uninterrupted_write_memory( (void *)(RSP_sig(sigcontext) + 4), &retaddr, 4 ))
+            {
+                TRACE_(seh)( "repair stepped x86 CALL from=%p to=%p\n",
+                             (void *)debug->step_rip, (void *)RIP_sig(sigcontext) );
+                RSP_sig(sigcontext) += 4;
+            }
+            debug->step_rip = RIP_sig(sigcontext);
+            debug->step_rsp = RSP_sig(sigcontext);
+            debug->step_cs = CS_sig(sigcontext);
+        }
+    }
+#endif
     save_context( data, &context, sigcontext );
 
+#ifdef __APPLE__
+    {
+        struct amd64_thread_data *debug = amd64_thread_data( data );
+        if (debug && debug->emulated_step && TRAP_sig(sigcontext) == TRAP_x86_TRCTRAP)
+        {
+            ULONG_PTR addresses[4] = { debug->dr0, debug->dr1, debug->dr2, debug->dr3 };
+            unsigned int i, hits = 0;
+            if (debug->step_count++ < 160)
+                TRACE_(seh)( "internal step rip=%p rsp=%p cs=%x\n", (void *)RIP_sig(sigcontext),
+                             (void *)RSP_sig(sigcontext), (unsigned int)CS_sig(sigcontext) );
+            for (i = 0; i < 4; i++)
+                if (((debug->dr7 >> (2 * i)) & 3) && !((debug->dr7 >> (16 + 4 * i)) & 15)
+                    && addresses[i] == RIP_sig(sigcontext) && !(EFL_sig(sigcontext) & 0x10000))
+                    hits |= 1 << i;
+            if (!hits && !debug->application_step)
+            {
+                EFL_sig(sigcontext) |= 0x100;
+                leave_handler( data, sigcontext );
+                return;
+            }
+            context.c.EFlags &= ~0x100;
+            context.c.Dr6 = debug->dr6 = (debug->dr6 & ~0x400f) | hits
+                                       | (debug->application_step ? 0x4000 : 0);
+            debug->dispatching_breakpoint = TRUE;
+            debug->emulated_step = FALSE;
+            rec.ExceptionCode = EXCEPTION_SINGLE_STEP;
+            TRACE_(seh)( "emulated execution breakpoint rip=%p dr6=%lx\n",
+                         (void *)context.c.Rip, (unsigned long)context.c.Dr6 );
+            setup_raise_exception( data, sigcontext, &rec, &context );
+            return;
+        }
+    }
+#endif
     switch (TRAP_sig(sigcontext))
