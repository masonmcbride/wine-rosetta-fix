+            wow_frame->SegSs = ds64_sel;
+            wow_frame->SegFs = amd64_data->fs;
+            cpu->Flags |= WOW64_CPURESERVED_FLAG_RESET_STATE;
+        }
+    }
+#endif
     return STATUS_SUCCESS;
