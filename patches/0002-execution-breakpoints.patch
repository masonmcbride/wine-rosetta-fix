+/* A TF trap occurs after an instruction. Check the resume PC separately so
+ * a breakpoint at the first instruction is not skipped. */
+static NTSTATUS rosetta_initial_breakpoint( struct thread_data *data )
+{
+#ifdef __APPLE__
+    struct amd64_thread_data *debug = amd64_thread_data( data );
+    struct syscall_frame *frame = get_syscall_frame( data );
+    ULONG_PTR addresses[4];
+    unsigned int i, hits = 0;
+    CONTEXT context;
+    EXCEPTION_RECORD rec = { .ExceptionCode = EXCEPTION_SINGLE_STEP };
+    NTSTATUS status;
+
+    if (is_wow64() || !debug || debug->dispatching_breakpoint ||
+        !rosetta_exec_breakpoints( debug ) || (frame->eflags & 0x10000)) return STATUS_SUCCESS;
+    addresses[0] = debug->dr0;
+    addresses[1] = debug->dr1;
+    addresses[2] = debug->dr2;
+    addresses[3] = debug->dr3;
+    for (i = 0; i < 4; i++)
+        if (((debug->dr7 >> (2 * i)) & 3) && !((debug->dr7 >> (16 + 4 * i)) & 15)
+            && addresses[i] == frame->rip) hits |= 1 << i;
+    if (!hits) return STATUS_SUCCESS;
+
+    context.ContextFlags = CONTEXT_ALL;
+    if ((status = NtGetContextThread( GetCurrentThread(), &context ))) return status;
+    context.Dr6 = debug->dr6 = (debug->dr6 & ~0x400f) | hits;
+    context.EFlags |= 0x10000;
+    rec.ExceptionAddress = (void *)context.Rip;
+    {
+        CONTEXT regs = context;
+        BOOL self;
+        regs.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+        if ((status = set_thread_context( GetCurrentThread(), &regs, &self, IMAGE_FILE_MACHINE_AMD64 ))) return status;
+    }
+    debug->dispatching_breakpoint = TRUE;
+    status = NtRaiseException( &rec, &context, TRUE );
+    debug->dispatching_breakpoint = FALSE;
+    return status;
+#else
+    return STATUS_SUCCESS;
+#endif
+}
