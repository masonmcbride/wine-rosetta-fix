+static BYTE *execution_breakpoint_code;
+static DWORD execution_breakpoint_thread_id;
+static LONG execution_breakpoint_hits;
+static const struct execution_breakpoint_test
+{
+    unsigned int offset, action, slots;
+} execution_breakpoint_tests[] =
+{
+    { 0, 0, 1 }, { 1, 0, 1 },  /* disable */
+    { 0, 1, 1 }, { 1, 1, 1 },  /* redirect */
+    { 0, 2, 1 }, { 1, 2, 1 },  /* unchanged continuation */
+    { 0, 0, 3 }, { 1, 0, 3 },  /* duplicate addresses */
+    { 0, 3, 1 }, { 1, 3, 1 },  /* RF continuation */
+};
+static const struct execution_breakpoint_test *execution_breakpoint_test;
+
+static LONG CALLBACK execution_breakpoint_handler( EXCEPTION_POINTERS *ptrs )
+{
+    const struct execution_breakpoint_test *test = execution_breakpoint_test;
+    CONTEXT *context = ptrs->ContextRecord;
+    ULONG_PTR pc;
+
+    if (GetCurrentThreadId() != execution_breakpoint_thread_id ||
+        ptrs->ExceptionRecord->ExceptionCode != EXCEPTION_SINGLE_STEP) return EXCEPTION_CONTINUE_SEARCH;
+#ifdef __i386__
+    pc = context->Eip;
+#else
+    pc = context->Rip;
+#endif
+    execution_breakpoint_hits++;
+    ok(pc == (ULONG_PTR)execution_breakpoint_code + test->offset, "unexpected pc %Ix\n", pc);
+    ok((context->Dr6 & 15) == test->slots, "unexpected Dr6 %Ix\n", (DWORD_PTR)context->Dr6);
+    if (execution_breakpoint_hits > 1 || test->action < 2) context->Dr7 = 0;
+    if (test->action == 1)
+    {
+#ifdef __i386__
+        context->Eip = (ULONG_PTR)execution_breakpoint_code + 16;
+#else
+        context->Rip = (ULONG_PTR)execution_breakpoint_code + 16;
+#endif
+    }
+    if (test->action == 3) context->EFlags |= 0x10000;
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+static DWORD WINAPI execution_breakpoint_thread( void *arg )
+{
+    const struct execution_breakpoint_test *test = arg;
+    CONTEXT context = {0};
+    NTSTATUS status;
+    DWORD result;
+
+    execution_breakpoint_thread_id = GetCurrentThreadId();
+    context.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+    context.Dr0 = (ULONG_PTR)execution_breakpoint_code + test->offset;
+    context.Dr1 = test->slots == 3 ? context.Dr0 : 0;
+    context.Dr7 = test->slots == 3 ? 5 : 1;
+    status = pNtSetContextThread(GetCurrentThread(), &context);
+    ok(!status, "NtSetContextThread failed with %lx\n", status);
+    if (status) return 0;
+    result = ((DWORD (CDECL *)(void))execution_breakpoint_code)();
+    ok(result == (test->action == 1 ? 2 : 1), "unexpected result %lu\n", result);
+    memset(&context, 0, sizeof(context));
+    context.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+    status = pNtSetContextThread(GetCurrentThread(), &context);
+    ok(!status, "NtSetContextThread failed with %lx\n", status);
+    return 0;
+}
+
+static void test_execution_breakpoints(void)
+{
+    static const BYTE code[] = { 0x90, 0x90, 0xb8, 1, 0, 0, 0, 0xc3 };
+    HANDLE thread;
+    void *handler;
+    DWORD ret;
+    unsigned int i;
+
+    if (is_arm64ec) return;
+    execution_breakpoint_code = VirtualAlloc(NULL, 32, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
+    ok(!!execution_breakpoint_code, "VirtualAlloc failed with %lu\n", GetLastError());
+    if (!execution_breakpoint_code) return;
+    memcpy(execution_breakpoint_code, code, sizeof(code));
+    memcpy(execution_breakpoint_code + 16, code + 2, sizeof(code) - 2);
+    execution_breakpoint_code[17] = 2;
+    FlushInstructionCache(GetCurrentProcess(), execution_breakpoint_code, 32);
+    handler = AddVectoredExceptionHandler(1, execution_breakpoint_handler);
+    ok(!!handler, "AddVectoredExceptionHandler failed\n");
+    if (!handler) goto done;
+    for (i = 0; i < ARRAY_SIZE(execution_breakpoint_tests); i++)
+    {
+        winetest_push_context("test %u", i);
+        execution_breakpoint_test = &execution_breakpoint_tests[i];
+        execution_breakpoint_hits = 0;
+        thread = CreateThread(NULL, 0, execution_breakpoint_thread, (void *)execution_breakpoint_test, 0, NULL);
+        ok(!!thread, "CreateThread failed with %lu\n", GetLastError());
+        if (thread)
+        {
+            ret = WaitForSingleObject(thread, 10000);
+            ok(ret == WAIT_OBJECT_0, "thread wait returned %#lx\n", ret);
+            if (ret != WAIT_OBJECT_0)
+            {
+                ret = TerminateThread(thread, 1);
+                ok(ret, "TerminateThread failed with %lu\n", GetLastError());
+                if (!ret) return; /* keep the handler and code alive for the running thread */
+                ret = WaitForSingleObject(thread, 10000);
+                ok(ret == WAIT_OBJECT_0, "terminated thread wait returned %#lx\n", ret);
+                if (ret != WAIT_OBJECT_0) return;
+            }
+            ok(execution_breakpoint_hits == 1, "got %ld breakpoint hits\n", execution_breakpoint_hits);
+            CloseHandle(thread);
+        }
+        winetest_pop_context();
+    }
+    RemoveVectoredExceptionHandler(handler);
+done:
+    VirtualFree(execution_breakpoint_code, 0, MEM_RELEASE);
+}
